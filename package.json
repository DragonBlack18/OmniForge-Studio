{
  "name": "omniforge-studio",
  "productName": "OmniForge Studio",
  "version": "0.6.1",
  "description": "Local engineering workbench: supervised workflows, extensions, CAD and durable offline-only scheduling",
  "private": true,
  "license": "UNLICENSED",
  "author": "Davi Brand",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "node --test",
    "test:core": "node --test",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "demo:core": "node scripts/demo-core.mjs",
    "smoke:cad-import": "node scripts/smoke-cad-import.mjs",
    "smoke:extensions": "node scripts/smoke-extensions.mjs",
    "smoke:schedules": "node scripts/smoke-schedules.mjs",
    "smoke:git": "node scripts/smoke-git.mjs",
    "smoke:ide": "node scripts/smoke-ide.mjs",
    "budget:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xyflow/react": "12.12.0",
    "concurrently": "9.2.1",
    "cross-env": "7.0.3",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "monaco-editor": "0.55.1",
    "playwright-core": "1.56.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "8.3.5",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.davibrand.omniforgestudio",
    "productName": "OmniForge Studio",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "core/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OmniForge-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OmniForge-Studio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "OmniForge-Studio-Portable-${version}-${arch}.${ext}"
    }
  }
}
